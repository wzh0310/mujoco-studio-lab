<mujoco model="panda pick place">
  <!-- 抓取演示场景: Franka Panda + 工作台 + 可抓取方块 + 目标区 -->
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.30 0.30 0.30" specular="0.08 0.08 0.08"/>
    <global azimuth="125" elevation="-18" fovy="42"/>
    <rgba haze="0.16 0.21 0.28 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.34 0.44 0.57" rgb2="0.04 0.06 0.09" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.21 0.25 0.31" rgb2="0.13 0.16 0.21"
      markrgb="0.85 0.85 0.85" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light pos="0.6 -0.8 2.2" dir="-0.3 0.4 -1" diffuse="0.70 0.70 0.70"/>
    <light pos="-1.0 0.5 1.8" diffuse="0.32 0.38 0.48"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
    <camera name="demo" pos="1.30 -1.15 1.05" xyaxes="0.707 0.707 0 -0.252 0.252 0.943"/>

    <body name="table" pos="0.48 0.02 0.10">
      <geom type="box" size="0.22 0.24 0.10" rgba="0.28 0.33 0.40 1" friction="1.0 0.1 0.005"/>
    </body>
    <body name="goal_pad" pos="0.48 0.14 0.203">
      <geom type="box" size="0.055 0.055 0.003" rgba="0.20 0.70 0.45 1" contype="0" conaffinity="0"/>
    </body>
    <body name="object" pos="0.50 -0.10 0.232">
      <freejoint/>
      <geom type="box" size="0.028 0.028 0.028" rgba="0.95 0.42 0.16 1" friction="2.0 0.1 0.005" density="400"/>
    </body>
  </worldbody>
</mujoco>
